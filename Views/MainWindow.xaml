<Window x:Class="GAB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GAB" Height="520" Width="890"
        MinHeight="400" MinWidth="750"
        Icon="/Resources/logo_gab.ico"
        Background="{DynamicResource MainBackground}"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing"
        AllowDrop="True"
        Drop="Window_Drop"
        DragEnter="Window_DragEnter">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra Superior / Cabecera de la Aplicación -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource HeaderBorderBrush}" BorderThickness="0,1,0,1" Padding="16,9">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="/Resources/logo_gab.png" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="GAB" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="14" Background="{DynamicResource HeaderBorderBrush}" Margin="10,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Gestor de Anuncios de Audio" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Botón de Ajustes (Engranaje) -->
                <Button x:Name="BtnAjustes" DockPanel.Dock="Right" Style="{DynamicResource IconButton}" Click="BtnAjustes_Click" 
                        ToolTip="Ajustes de GAB" VerticalAlignment="Center" Width="32" Height="32" Padding="0">
                    <Path Width="17" Height="17" Stretch="Uniform" Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                </Button>
            </DockPanel>
        </Border>

        <!-- Tabla de Anuncios (DataGrid) -->
        <DataGrid x:Name="GridAnuncios" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="None" FocusVisualStyle="{x:Null}"
                  MouseDoubleClick="GridAnuncios_MouseDoubleClick">
            <DataGrid.Columns>
                <!-- Columna Número de Fila -->
                <DataGridTemplateColumn Header="#" Width="46">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource AccentBrush}" CornerRadius="4" Margin="4,2" Padding="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <TextBlock Text="{Binding NumeroFila}" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="180" IsReadOnly="True" />
                <DataGridTextColumn Header="Días" Binding="{Binding DiasSemanaString}" Width="170" IsReadOnly="True" />
                <DataGridTextColumn Header="Horario" Binding="{Binding HorarioString}" Width="*" IsReadOnly="True" />

                <!-- Columna Reproducir con Botón Play/Stop por fila -->
                <DataGridTemplateColumn Header="Reproducir" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{Binding PlayButtonText}" 
                                    Style="{DynamicResource RowPlayButton}" 
                                    Click="BtnPlayRow_Click" 
                                    Margin="4,2" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Barra Inferior de Botones Principales -->
        <Grid Grid.Row="2" Margin="14,10,14,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BtnAgregar" Grid.Column="0" Content="Agregar anuncio" Style="{DynamicResource PrimaryGreenButton}" Click="BtnAgregar_Click" Margin="0,0,6,0" Padding="0,9" FontSize="13"/>
            <Button x:Name="BtnEditar" Grid.Column="1" Content="Editar anuncio" Style="{DynamicResource PrimaryGreenButton}" Click="BtnEditar_Click" Margin="6,0,6,0" Padding="0,9" FontSize="13"/>
            <Button x:Name="BtnEliminar" Grid.Column="2" Content="Eliminar anuncio" Style="{DynamicResource PrimaryGreenButton}" Click="BtnEliminar_Click" Margin="6,0,6,0" Padding="0,9" FontSize="13"/>
            <Button x:Name="BtnVerLog" Grid.Column="3" Content="Ver log" Style="{DynamicResource PrimaryGreenButton}" Click="BtnVerLog_Click" Margin="6,0,0,0" Padding="0,9" FontSize="13"/>
        </Grid>

        <!-- Pie de Página con Estado -->
        <DockPanel Grid.Row="3" Margin="16,4,16,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock x:Name="TxtStatus" Text="Listo." Foreground="{DynamicResource TextSecondary}" FontSize="12" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
