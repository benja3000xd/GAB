<Window x:Class="GAB.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar Anuncio" Height="535" Width="730"
        MinWidth="700"
        Icon="/Resources/logo_gab.ico"
        Background="{DynamicResource MainBackground}"
        WindowStartupLocation="CenterOwner"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        ResizeMode="NoResize">
    <Grid Margin="22,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nombre del Anuncio -->
        <TextBlock Grid.Row="0" Text="Nombre:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtNombre" Grid.Row="1" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

        <!-- Archivo de Audio -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Audio:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="TxtRutaAudio" Grid.Column="1" IsReadOnly="True" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="BtnSeleccionarAudio" Grid.Column="2" Content="Seleccionar audio" Style="{DynamicResource PrimaryGreenButton}" Click="BtnSeleccionarAudio_Click" Height="36" Padding="16,0"/>
        </Grid>

        <!-- Días de la semana -->
        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="Días:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
            <WrapPanel x:Name="PanelDias" VerticalAlignment="Center">
                <CheckBox Content="Lunes" Margin="0,0,14,6" Tag="1" VerticalAlignment="Center"/>
                <CheckBox Content="Martes" Margin="0,0,14,6" Tag="2" VerticalAlignment="Center"/>
                <CheckBox Content="Miércoles" Margin="0,0,14,6" Tag="3" VerticalAlignment="Center"/>
                <CheckBox Content="Jueves" Margin="0,0,14,6" Tag="4" VerticalAlignment="Center"/>
                <CheckBox Content="Viernes" Margin="0,0,14,6" Tag="5" VerticalAlignment="Center"/>
                <CheckBox Content="Sábado" Margin="0,0,14,6" Tag="6" VerticalAlignment="Center"/>
                <CheckBox Content="Domingo" Margin="0,0,18,6" Tag="0" VerticalAlignment="Center"/>
                <Button x:Name="BtnTodosLosDias" Content="Todos los días" Style="{DynamicResource PrimaryGreenButton}" Click="BtnTodosLosDias_Click" Padding="14,4" Height="28" Margin="0,0,0,6" FontSize="12" VerticalAlignment="Center"/>
            </WrapPanel>
        </StackPanel>

        <!-- Horas fijas -->
        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <TextBlock Text="Hora(s) (HH:MM, 24h, separadas por coma):" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="TxtHorasFijas" MinHeight="36" VerticalContentAlignment="Center" Margin="0,0,0,4"/>
        </StackPanel>

        <!-- Intervalo -->
        <Border Grid.Row="5" Background="{DynamicResource SurfaceBackground}" BorderBrush="{DynamicResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,14">
            <StackPanel>
                <CheckBox x:Name="ChkRepetirIntervalo" Content="Repetir cada X minutos en rango horario" FontWeight="SemiBold" Checked="ChkRepetirIntervalo_Changed" Unchecked="ChkRepetirIntervalo_Changed" Margin="0,0,0,10"/>
                <StackPanel x:Name="PanelIntervaloConfig" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding ElementName=ChkRepetirIntervalo, Path=IsChecked}">
                    <TextBlock Text="Cada" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtIntervalo" Width="55" Height="32" Text="30" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="minutos" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,16,0"/>
                    <TextBlock Text="Rango:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtHoraInicio" Width="70" Height="32" Text="08:00" TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="a" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtHoraFin" Width="70" Height="32" Text="18:00" TextAlignment="Center" VerticalContentAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Botones Inferiores -->
        <DockPanel Grid.Row="7" LastChildFill="False">
            <TextBlock Text="* Sin días seleccionados, el anuncio queda desactivado." 
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" 
                       FontSize="11" FontStyle="Italic" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnCancelar" Content="Cancelar" Click="BtnCancelar_Click" IsCancel="True" Margin="0,0,10,0" Padding="18,8"/>
                <Button x:Name="BtnGuardar" Content="Aceptar" Click="BtnGuardar_Click" IsDefault="True" Style="{DynamicResource PrimaryGreenButton}" Padding="22,8"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
